# palette.tohobeads.jp 用
# HTMLはキャッシュさせない(JS/CSSはURLのバージョン付与で更新を届ける)
# sw.js と manifest.json は固定URLなので、同じくキャッシュさせない
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>
# manifest.json だけ MIME タイプを明示する
# (data/beads.json などは application/json のままにしたいので、拡張子単位では変えない)
<IfModule mod_headers.c>
  <Files "manifest.json">
    Header set Content-Type "application/manifest+json"
  </Files>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
